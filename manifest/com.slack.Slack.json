{
  "id": "@APP_ID@",
  "runtime": "@RUNTIME@",
  "runtime-version": "@RUNTIME_VERSION@",
  "sdk": "@RUNTIME_SDK@",
  "sdk-version": "@RUNTIME_VERSION@",
  "command": "slack",
  "separate-locales": false,
  "appstream-compose": false,
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=x11",
    "--socket=session-bus",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.ScreenSaver",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--env=SLACK_FLATPAK=1"
  ],
  "modules": [
    {
      "name": "pw-camera-filter",
      "buildsystem": "simple",
      "sources": [ { "type": "dir", "path": "pw-camera-filter" } ],
      "build-commands": [ "sh build.sh" ]
    },
    {
      "name": "slack",
      "buildsystem": "simple",
      "sources": [
        { "type": "file", "path": "slack-overlay.tar.xz" },
        { "type": "file", "path": "slack-install.sh" },
        { "type": "file", "path": "apply_extra" },
        { "type": "file", "path": "metainfo.xml" },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/flathub/com.slack.Slack/5ca042e7dd604eb51238c11b9dfc38e1119e34d6/slack.svg",
          "sha256": "717085b5547111e5c5f7482f1241d94d52bbbdb5d655fd583094c1be09c746ae"
        },
        {
          "type": "extra-data",
          "filename": "slack.deb",
          "url": "@SLACK_DEB_URL@",
          "sha256": "@SLACK_DEB_SHA256@",
          "size": @SLACK_DEB_SIZE@
        },
        {
          "type": "extra-data",
          "filename": "slack-desktop-utils.tar.gz",
          "url": "@SDU_URL@",
          "sha256": "@SDU_SHA256@",
          "size": @SDU_SIZE@
        }
      ],
      "build-commands": [
        "tar xJf slack-overlay.tar.xz --no-same-owner",
        "sh slack-install.sh"
      ]
    }
  ]
}
